{
  "name": "@labyrinth/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative Colyseus game server for Labyrinth",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --conditions=source src/index.ts",
    "build": "rimraf build && tsc -p tsconfig.build.json",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.34",
    "@colyseus/tools": "^0.18.4",
    "@labyrinth/rules": "*",
    "colyseus": "^0.18.8",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.4",
    "@colyseus/testing": "^0.18.6",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.2"
  }
}
